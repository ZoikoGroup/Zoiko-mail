    {
      "name": "Lifecycle and Jobs",
      "item": [
        { "name": "List Lifecycle Requests", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/lifecycle" } },
        { "name": "Request Export", "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===202){const d=pm.response.json().data;pm.collectionVariables.set('lifecycleRequestId',d.request.id);pm.collectionVariables.set('jobId',d.job.id);}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"idempotencyKey\":\"postman-export-001\",\"reason\":\"Postman verification\"}" }, "url": "{{baseUrl}}/api/v1/lifecycle/exports" } },
