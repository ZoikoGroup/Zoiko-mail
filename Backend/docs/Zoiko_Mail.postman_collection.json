        { "name": "Create Draft", "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===201){const d=pm.response.json().data;pm.collectionVariables.set('messageId',d.id);if(d.threadId)pm.collectionVariables.set('threadId',d.threadId);}"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"subject\":\"Postman test\",\"textBody\":\"Hello from Postman\",\"recipients\":{\"to\":[\"member@zoiko.test\"],\"cc\":[],\"bcc\":[]}}" }, "url": "{{baseUrl}}/api/v1/mail/drafts" } },
        { "name": "Update Draft", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"subject\":\"Updated Postman test\",\"textBody\":\"Updated body\"}" }, "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}" } },
        { "name": "Send Draft", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}/send" } },
        { "name": "Schedule Draft", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"scheduledAt\":\"2026-12-31T10:00:00.000Z\"}" }, "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}/schedule" } },
        { "name": "Cancel Schedule", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}/schedule" } },
        { "name": "Delete Draft", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}" } },
        { "name": "Get Mailbox Message", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/mail/{{messageId}}" } },
        { "name": "Update Mailbox Message", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"isRead\":true,\"isStarred\":true,\"folder\":\"ARCHIVE\"}" }, "url": "{{baseUrl}}/api/v1/mail/{{messageId}}" } },
        { "name": "Bulk Mailbox Action", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"messageIds\":[\"{{messageId}}\"],\"action\":\"MARK_READ\"}" }, "url": "{{baseUrl}}/api/v1/mail/bulk" } },
        { "name": "Reply", "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===201)pm.collectionVariables.set('messageId',pm.response.json().data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"textBody\":\"Reply from Postman\"}" }, "url": "{{baseUrl}}/api/v1/mail/{{messageId}}/reply" } },
        { "name": "Reply All", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"textBody\":\"Reply all from Postman\"}" }, "url": "{{baseUrl}}/api/v1/mail/{{messageId}}/reply-all" } },
        { "name": "Forward", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"textBody\":\"Forwarded from Postman\",\"recipients\":{\"to\":[\"member@zoiko.test\"],\"cc\":[],\"bcc\":[]}}" }, "url": "{{baseUrl}}/api/v1/mail/{{messageId}}/forward" } },
        { "name": "Delivery Events", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/mail/{{messageId}}/delivery-events" } },
        { "name": "Upload Attachment", "request": { "method": "POST", "body": { "mode": "formdata", "formdata": [{ "key": "file", "type": "file", "src": "" }] }, "url": "{{baseUrl}}/api/v1/mail/drafts/{{messageId}}/attachments" } },
