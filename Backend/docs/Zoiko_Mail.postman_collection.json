    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "event": [
            { "listen": "prerequest", "script": { "exec": ["pm.environment.set('testEmail', `postman-${Date.now()}@zoiko.test`);"] } },
            { "listen": "test", "script": { "exec": ["const d=pm.response.json().data; pm.environment.set('accessToken',d.tokens.accessToken); pm.environment.set('refreshToken',d.tokens.refreshToken); pm.environment.set('tenantId',d.tenant.id); pm.environment.set('membershipId',d.membership.id);"] } }
          ],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"displayName\": \"Postman User\",\n  \"tenantName\": \"Postman Tenant\",\n  \"planCode\": \"starter\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/register" }
        },
        {
          "name": "Login",
          "event": [{ "listen": "test", "script": { "exec": ["const d=pm.response.json().data; if(d.accessToken){pm.environment.set('accessToken',d.accessToken);pm.environment.set('refreshToken',d.refreshToken);pm.environment.set('tenantId',d.tenant.id);pm.environment.set('membershipId',d.membership.id);}"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\",\n  \"tenantId\": \"{{tenantId}}\"\n}" }, "url": "{{baseUrl}}/api/v1/auth/login" }
        },
        {
          "name": "Refresh",
          "event": [{ "listen": "test", "script": { "exec": ["const d=pm.response.json().data; pm.environment.set('accessToken',d.accessToken); pm.environment.set('refreshToken',d.refreshToken);"] } }],
          "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/refresh" }
        },
        { "name": "Current Session", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/auth/me" } },
        { "name": "Change Password", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Password123!\",\"newPassword\":\"NewPassword123!\"}" }, "url": "{{baseUrl}}/api/v1/auth/change-password" } },
        { "name": "Logout", "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"refreshToken\":\"{{refreshToken}}\"}" }, "url": "{{baseUrl}}/api/v1/auth/logout" } },
        { "name": "Logout All", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/auth/logout-all" } }
      ]
    },
