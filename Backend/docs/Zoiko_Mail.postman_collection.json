        { "name": "Readiness", "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/ready" } },
        { "name": "Metrics", "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [{ "key": "x-operations-key", "value": "{{operationsKey}}" }], "url": "{{baseUrl}}/api/metrics" } },
