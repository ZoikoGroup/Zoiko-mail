    {
      "name": "Track A Connectors",
      "item": [
        { "name": "List Connected Accounts", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/connectors" } },
        { "name": "Create Gmail Read-only Mapping", "event": [{ "listen": "test", "script": { "exec": ["if(pm.response.code===201)pm.collectionVariables.set('connectedAccountId',pm.response.json().data.id);"] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"provider\":\"GMAIL\",\"providerAccountId\":\"postman-gmail-account\",\"email\":\"postman@gmail.test\",\"scopes\":[\"https://www.googleapis.com/auth/gmail.readonly\"]}" }, "url": "{{baseUrl}}/api/v1/connectors" } },
        { "name": "Receive Signed Provider Callback", "event": [{ "listen": "prerequest", "script": { "exec": ["const body=pm.request.body.raw;const secret=pm.environment.get('providerCallbackSecret')||pm.collectionVariables.get('providerCallbackSecret');const digest=CryptoJS.HmacSHA256(body,secret).toString(CryptoJS.enc.Hex);pm.request.headers.upsert({key:'x-provider-signature',value:'sha256='+digest});"] } }], "request": { "auth": { "type": "noauth" }, "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"providerEventId\":\"postman-event-001\",\"providerAccountId\":\"postman-gmail-account\",\"eventType\":\"MAILBOX_CHANGED\",\"resourceType\":\"MAILBOX\",\"resourceId\":\"postman-gmail-account\",\"occurredAt\":\"2026-07-28T12:00:00.000Z\"}" }, "url": "{{baseUrl}}/api/v1/connectors/callbacks/GMAIL" } },
        { "name": "List Sanitized Provider Events", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/connectors/{{connectedAccountId}}/events" } },
        { "name": "Provider Health", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/connectors/health" } },
        { "name": "List Dead-letter Events", "event": [{ "listen": "test", "script": { "exec": ["const events=pm.response.json().data.events;if(events&&events.length)pm.collectionVariables.set('providerEventId',events[0].id);"] } }], "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/connectors/dead-letter" } },
        { "name": "Replay Dead-letter Event", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/connectors/dead-letter/{{providerEventId}}/replay" } },
        { "name": "Disconnect Provider Account", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/v1/connectors/{{connectedAccountId}}" } }
