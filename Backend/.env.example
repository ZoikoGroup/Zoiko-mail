# Zoiko Mail backend — example environment.
# Copy to .env and replace every value. Never commit .env.
# Production startup rejects secrets containing "change-me", "example",
# "development" or "test-secret" (see src/config/env.ts).

# ── Required ────────────────────────────────────────────────────────────
# Database password used by docker-compose to provision Postgres.
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# docker-compose builds DATABASE_URL for the container from POSTGRES_PASSWORD,
# but local tooling (prisma generate, migrate, studio, seed) reads it from here.
# Host port 5432 only resolves if you expose it; `prisma generate` needs the
# variable to be present but does not connect.
DATABASE_URL=postgresql://zoiko:replace-with-a-strong-database-password@localhost:5432/zoiko_mail?schema=public

# Application secrets. Minimum 32 characters each.
# JWT_ACCESS_SECRET and JWT_REFRESH_SECRET must differ from each other.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
OPERATIONS_KEY=replace-with-at-least-32-random-characters
PROVIDER_CALLBACK_SECRET=replace-with-a-different-32-character-secret

# Comma-free single origin of the frontend. Wildcards are prohibited.
CORS_ORIGIN=http://localhost:3000

# ── Optional, with defaults ─────────────────────────────────────────────
API_PORT=5000
LOG_LEVEL=info
TRUST_PROXY=1

# ── Live mailbox provider ───────────────────────────────────────────────
# Leave MAIL_PROVIDER_ENABLED=false for local development. When false the
# MAIL_PROVIDER_* values below are ignored and may be left blank.
MAIL_PROVIDER_ENABLED=false
IMAP_HOST=imap.secureserver.net
IMAP_PORT=993
IMAP_SECURE=true
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true

# Required only when MAIL_PROVIDER_ENABLED=true.
# Store the password in the deployment platform's secret manager, never here.
MAIL_PROVIDER_USERNAME=
MAIL_PROVIDER_PASSWORD=
MAIL_PROVIDER_FROM_ADDRESS=
MAIL_PROVIDER_TENANT_ID=
MAIL_PROVIDER_MEMBERSHIP_ID=
MAIL_PROVIDER_SYNC_INTERVAL_MS=300000
MAIL_PROVIDER_CONNECTION_TIMEOUT_MS=15000
