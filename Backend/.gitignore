node_modules/
dist/
.env*
.env
.env.local
.env.test
# Committed template; the patterns above would otherwise swallow it.
.env.example
coverage/
*.log
storage/
# Local writable secret store (connector OAuth tokens) — never commit.
.secrets/

# A local Python virtualenv. Nothing here is Python — no .py files, no
# requirements.txt — so it is a scratch environment rather than part of
# the build. It sits under Backend/ because the repository is meant to be
# two folders, which is also why this rule lives here rather than in a
# root .gitignore.
venv/
.venv/

# TypeScript incremental build cache. Not generated today — this tsconfig is
# not incremental — but `tsc --build` or turning that flag on would produce it,
# and the frontend already had one committed by accident. Same rule there.
*.tsbuildinfo
