# Local Python virtual environments. Nothing here is Python, but the repo is
# only Backend/ and Frontend/, so a venv made while working has nowhere else to
# land — and a venv is ~22MB of machine-specific binaries that must never be
# committed. Backend/.gitignore carries the same rule.
venv/
.venv/

# TypeScript incremental build cache. tsconfig.json sets "incremental": true,
# so tsc rewrites this on every typecheck — it was tracked, which meant a dirty
# working tree after any build and a 150KB binary diff on every commit that
# touched types. Machine-local state, regenerated on demand.
tsconfig.tsbuildinfo
*.tsbuildinfo
